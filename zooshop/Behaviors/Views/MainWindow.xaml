<ui:FluentWindow
    x:Class="ZooShop.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Любимый питомец"
    Width="1150" Height="700"
    MinWidth="900" MinHeight="600"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="False"
    WindowBackdropType="None"
    Closing="Window_Closing">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Sidebar ── -->
        <Border Grid.Column="0"
                Background="{DynamicResource AppSidebarBg}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo + user -->
                <StackPanel Grid.Row="0" Margin="16,20,16,16"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                            Cursor="SizeAll">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="40" Height="40" CornerRadius="10"
                                Background="{DynamicResource AppAccentBrush}">
                            <ui:SymbolIcon Symbol="AnimalCat24" FontSize="22"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Любимый питомец"
                                       FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="Зоомагазин" FontSize="10" Opacity="0.55"/>
                        </StackPanel>
                    </StackPanel>

                    <Border CornerRadius="8" Padding="10,8"
                            Background="#28000000">
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentUser.FullName}"
                                       FontWeight="Medium" FontSize="12"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CurrentUser.Role}"
                                       FontSize="10" Opacity="0.55" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Separator Grid.Row="1" Margin="16,0,16,8" Opacity="0.2"/>

                <!-- Nav items -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,0">
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItemStyle}"
                                     GroupName="Nav" IsChecked="True"
                                     Click="NavItem_Clicked" Tag="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Home24" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Главная" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItemStyle}" GroupName="Nav"
                                     Click="NavItem_Clicked" Tag="Products">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Box24" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Товары" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItemStyle}" GroupName="Nav"
                                     Click="NavItem_Clicked" Tag="Animals">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="AnimalCat24" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Животные" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItemStyle}" GroupName="Nav"
                                     Click="NavItem_Clicked" Tag="Deliveries">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Поставки" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItemStyle}" GroupName="Nav"
                                     Click="NavItem_Clicked" Tag="Sales">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Receipt24" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Продажи" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItemStyle}" GroupName="Nav"
                                     Click="NavItem_Clicked" Tag="Staff"
                                     Visibility="{Binding CanViewStaff,
                                         Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="People24" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Персонал" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItemStyle}" GroupName="Nav"
                                     Click="NavItem_Clicked" Tag="Reports">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DocumentArrowDown24" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Отчёты" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>

                <!-- Theme switcher + logout -->
                <StackPanel Grid.Row="3" Margin="16,8,16,16">
                    <Separator Opacity="0.2" Margin="0,0,0,10"/>

                    <TextBlock Text="Тема" FontSize="10" Opacity="0.5" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ThemeCircleStyle}"
                                Background="#81C784" Margin="0,0,6,0"
                                Click="ThemeGreen_Click" ToolTip="Зелёная"/>
                        <Button Style="{StaticResource ThemeCircleStyle}"
                                Background="#FFD54F" Margin="0,0,6,0"
                                Click="ThemeYellow_Click" ToolTip="Жёлтая"/>
                        <Button Style="{StaticResource ThemeCircleStyle}"
                                Background="#64B5F6"
                                Click="ThemeBlue_Click" ToolTip="Голубая"/>
                    </StackPanel>

                    <Button Margin="0,12,0,0" Padding="12,8"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand"
                            Click="Logout_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowExit20" FontSize="16" Margin="0,0,10,0"
                                           Foreground="#D32F2F"/>
                            <TextBlock Text="Выйти" VerticalAlignment="Center"
                                       FontSize="13" Foreground="#D32F2F"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Content area ── -->
        <Grid Grid.Column="1" Background="{DynamicResource AppPageBg}">

            <!-- Decorative leaf background -->
            <Canvas IsHitTestVisible="False" Opacity="0.07" ClipToBounds="True">
                <Path Fill="#4CAF50" Canvas.Left="95"  Canvas.Top="40"  RenderTransformOrigin="0.5,0.5"
                      Data="M0,0 C-18,12 -18,36 0,48 C18,36 18,12 0,0Z">
                    <Path.RenderTransform><RotateTransform Angle="-20"/></Path.RenderTransform>
                </Path>
                <Path Fill="#66BB6A" Canvas.Left="620" Canvas.Top="110" RenderTransformOrigin="0.5,0.5"
                      Data="M0,0 C-24,16 -24,48 0,64 C24,48 24,16 0,0Z">
                    <Path.RenderTransform><RotateTransform Angle="35"/></Path.RenderTransform>
                </Path>
                <Path Fill="#388E3C" Canvas.Left="330" Canvas.Top="240" RenderTransformOrigin="0.5,0.5"
                      Data="M0,0 C-14,9 -14,27 0,36 C14,27 14,9 0,0Z">
                    <Path.RenderTransform><RotateTransform Angle="15"/></Path.RenderTransform>
                </Path>
                <Path Fill="#81C784" Canvas.Left="760" Canvas.Top="320" RenderTransformOrigin="0.5,0.5"
                      Data="M0,0 C-20,14 -20,42 0,56 C20,42 20,14 0,0Z">
                    <Path.RenderTransform><RotateTransform Angle="-40"/></Path.RenderTransform>
                </Path>
                <Path Fill="#4CAF50" Canvas.Left="40"  Canvas.Top="420" RenderTransformOrigin="0.5,0.5"
                      Data="M0,0 C-16,11 -16,33 0,44 C16,33 16,11 0,0Z">
                    <Path.RenderTransform><RotateTransform Angle="5"/></Path.RenderTransform>
                </Path>
                <Path Fill="#66BB6A" Canvas.Left="470" Canvas.Top="480" RenderTransformOrigin="0.5,0.5"
                      Data="M0,0 C-22,15 -22,45 0,60 C22,45 22,15 0,0Z">
                    <Path.RenderTransform><RotateTransform Angle="-25"/></Path.RenderTransform>
                </Path>
                <Path Fill="#A5D6A7" Canvas.Left="720" Canvas.Top="60"  RenderTransformOrigin="0.5,0.5"
                      Data="M0,0 C-12,8 -12,24 0,32 C12,24 12,8 0,0Z">
                    <Path.RenderTransform><RotateTransform Angle="50"/></Path.RenderTransform>
                </Path>
                <Path Fill="#388E3C" Canvas.Left="190" Canvas.Top="330" RenderTransformOrigin="0.5,0.5"
                      Data="M0,0 C-19,13 -19,39 0,52 C19,39 19,13 0,0Z">
                    <Path.RenderTransform><RotateTransform Angle="-35"/></Path.RenderTransform>
                </Path>
                <Path Fill="#81C784" Canvas.Left="860" Canvas.Top="220" RenderTransformOrigin="0.5,0.5"
                      Data="M0,0 C-15,10 -15,30 0,40 C15,30 15,10 0,0Z">
                    <Path.RenderTransform><RotateTransform Angle="10"/></Path.RenderTransform>
                </Path>
                <Path Fill="#4CAF50" Canvas.Left="380" Canvas.Top="570" RenderTransformOrigin="0.5,0.5"
                      Data="M0,0 C-25,17 -25,51 0,68 C25,51 25,17 0,0Z">
                    <Path.RenderTransform><RotateTransform Angle="-10"/></Path.RenderTransform>
                </Path>
                <Path Fill="#66BB6A" Canvas.Left="850" Canvas.Top="520" RenderTransformOrigin="0.5,0.5"
                      Data="M0,0 C-13,9 -13,27 0,36 C13,27 13,9 0,0Z">
                    <Path.RenderTransform><RotateTransform Angle="60"/></Path.RenderTransform>
                </Path>
                <Path Fill="#A5D6A7" Canvas.Left="200" Canvas.Top="560" RenderTransformOrigin="0.5,0.5"
                      Data="M0,0 C-17,12 -17,36 0,48 C17,36 17,12 0,0Z">
                    <Path.RenderTransform><RotateTransform Angle="-55"/></Path.RenderTransform>
                </Path>
            </Canvas>

            <Frame x:Name="ContentFrame" Margin="0"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
