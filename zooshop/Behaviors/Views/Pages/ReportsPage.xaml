<Page
    x:Class="ZooShop.Views.Pages.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Отчёты">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,24">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">

            <!-- Header -->
            <TextBlock Text="Отчёты" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Экспорт данных в CSV (открывается в Excel)" FontSize="12"
                       Opacity="0.55" Margin="0,0,0,20"/>

            <!-- Folder selector -->
            <Border CornerRadius="10" Padding="16,12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Папка для сохранения" FontSize="12" FontWeight="Medium" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding FolderPath}" FontSize="11" Opacity="0.6"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <ui:Button Grid.Column="1" Command="{Binding PickFolderCommand}"
                               Appearance="Secondary" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Folder24" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Обзор…" FontSize="12"/>
                        </StackPanel>
                    </ui:Button>
                </Grid>
            </Border>

            <!-- Status bar -->
            <ui:InfoBar Severity="{Binding StatusSeverity}"
                        Message="{Binding StatusMessage}"
                        IsOpen="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToFalseConverter}}"
                        IsClosable="False"
                        Margin="0,0,0,16"/>

            <!-- ── Sales ── -->
            <Border CornerRadius="10" Padding="16"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="36" Height="36" CornerRadius="8"
                                Background="#E8F5E9" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="Receipt24" FontSize="18" Foreground="#388E3C"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Продажи" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Журнал всех продаж товаров и животных" FontSize="11" Opacity="0.55"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="С" FontSize="11" Opacity="0.55" Margin="0,0,0,3"/>
                            <DatePicker SelectedDate="{Binding SalesFrom}" FontSize="12" Width="130"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="По" FontSize="11" Opacity="0.55" Margin="0,0,0,3"/>
                            <DatePicker SelectedDate="{Binding SalesTo}" FontSize="12" Width="130"/>
                        </StackPanel>
                        <Grid Grid.Column="2"/>
                        <ui:Button Grid.Column="3" VerticalAlignment="Bottom"
                                   Command="{Binding ExportSalesCommand}"
                                   Appearance="Primary">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Экспорт CSV" FontSize="12"/>
                            </StackPanel>
                        </ui:Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── Products ── -->
            <Border CornerRadius="10" Padding="16"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="8"
                                Background="#E3F2FD" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="Box24" FontSize="18" Foreground="#1976D2"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Товары" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Весь ассортимент с остатками и сроками годности" FontSize="11" Opacity="0.55"/>
                        </StackPanel>
                    </StackPanel>
                    <ui:Button Grid.Column="1" Command="{Binding ExportProductsCommand}"
                               Appearance="Primary">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Экспорт CSV" FontSize="12"/>
                        </StackPanel>
                    </ui:Button>
                </Grid>
            </Border>

            <!-- ── Animals ── -->
            <Border CornerRadius="10" Padding="16"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="8"
                                Background="#FFF3E0" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="AnimalCat24" FontSize="18" Foreground="#E65100"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Животные" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Список животных, цены и состояние здоровья" FontSize="11" Opacity="0.55"/>
                        </StackPanel>
                    </StackPanel>
                    <ui:Button Grid.Column="1" Command="{Binding ExportAnimalsCommand}"
                               Appearance="Primary">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Экспорт CSV" FontSize="12"/>
                        </StackPanel>
                    </ui:Button>
                </Grid>
            </Border>

            <!-- ── Deliveries ── -->
            <Border CornerRadius="10" Padding="16"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="36" Height="36" CornerRadius="8"
                                Background="#F3E5F5" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="18" Foreground="#7B1FA2"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Поставки" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="История поставок с детализацией по товарам" FontSize="11" Opacity="0.55"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="С" FontSize="11" Opacity="0.55" Margin="0,0,0,3"/>
                            <DatePicker SelectedDate="{Binding DelFrom}" FontSize="12" Width="130"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="По" FontSize="11" Opacity="0.55" Margin="0,0,0,3"/>
                            <DatePicker SelectedDate="{Binding DelTo}" FontSize="12" Width="130"/>
                        </StackPanel>
                        <Grid Grid.Column="2"/>
                        <ui:Button Grid.Column="3" VerticalAlignment="Bottom"
                                   Command="{Binding ExportDeliveriesCommand}"
                                   Appearance="Primary">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Экспорт CSV" FontSize="12"/>
                            </StackPanel>
                        </ui:Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Spinner -->
            <ui:ProgressRing IsIndeterminate="True" Height="28" Margin="0,16,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>

        </StackPanel>
    </ScrollViewer>
</Page>
