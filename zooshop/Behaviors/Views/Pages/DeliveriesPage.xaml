<Page
    x:Class="ZooShop.Views.Pages.DeliveriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Style="{StaticResource FadeInPage}"
    Title="Поставки">

    <Grid Margin="24,16,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Поставки" Foreground="Black" Style="{StaticResource PageTitleStyle}"
                           VerticalAlignment="Center"/>
                <ui:Button Content="Обновить"
                           Icon="{ui:SymbolIcon ArrowClockwise24}"
                           Command="{Binding LoadCommand}"
                           Appearance="Secondary"
                           HorizontalAlignment="Right"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Deliveries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="14,10"
                                    CornerRadius="8"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DateDisplay}"
                                                                                             FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{Binding SummaryDisplay}"
                                                                                             FontSize="12" Opacity="0.65"
                                               Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="1" Style="{StaticResource FormCardStyle}"
                VerticalAlignment="Top"
                Visibility="{Binding CanAccept,
                    Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Новая поставка"
                                                     FontSize="16" FontWeight="SemiBold"
                           Margin="0,0,0,16"/>

                <TextBlock Text="Поставщик" Foreground="Black" Style="{StaticResource FieldLabelStyle}"/>
                <ui:TextBox Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Название поставщика"
                            Margin="0,0,0,12"/>

                <TextBlock Text="Товар" Foreground="Black" Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox ItemsSource="{Binding Products}"
                          SelectedItem="{Binding SelectedProduct}"
                          DisplayMemberPath="Name"
                                                   Margin="0,0,0,12"
                          HorizontalAlignment="Stretch"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Количество" Foreground="Black" Style="{StaticResource FieldLabelStyle}"/>
                        <ui:NumberBox Value="{Binding DeliveryQuantity, Mode=TwoWay}"
                                      Minimum="1" SpinButtonPlacementMode="Compact"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Цена закупки (₽)" Foreground="Black" Style="{StaticResource FieldLabelStyle}"/>
                        <ui:NumberBox Value="{Binding DeliveryUnitCost, Mode=TwoWay}"
                                      Minimum="0" SpinButtonPlacementMode="Compact"/>
                    </StackPanel>
                </Grid>

                <ui:InfoBar IsOpen="{Binding AddError,
                                Converter={StaticResource NullOrEmptyToFalseConverter}}"
                            Severity="Error" Title="{Binding AddError}"
                            IsClosable="False" Margin="0,0,0,8"/>

                <ui:Button Content="Добавить позицию"
                                                     Icon="{ui:SymbolIcon Add24}"
                           Command="{Binding AddToDeliveryCommand}"
                           Appearance="Primary"
                           HorizontalAlignment="Stretch"
                           Margin="0,0,0,12"/>

                <Separator Opacity="0.2" Margin="0,0,0,12"/>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Margin="0,16,0,16"
                            Visibility="{Binding IsCartEmpty,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                    <ui:SymbolIcon Symbol="Box24" FontSize="40" Opacity="0.2"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Позиции не добавлены"
                                                             Opacity="0.5" FontSize="12" TextAlignment="Center"/>
                </StackPanel>

                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsCartNotEmpty,
                                  Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding Cart}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="10,8"
                                        CornerRadius="6"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <TextBlock Text="{Binding Product.Name}"
                                                                                                             FontWeight="SemiBold" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="200"/>
                                            <ui:Button HorizontalAlignment="Right"
                                                       Width="24" Height="24" Padding="0"
                                                       Appearance="Secondary"
                                                       Icon="{ui:SymbolIcon Dismiss16}"
                                                       Command="{Binding DataContext.RemoveFromDeliveryCommand,
                                                           RelativeSource={RelativeSource AncestorType=Page}}"
                                                       CommandParameter="{Binding}"/>
                                        </Grid>
                                        <TextBlock Grid.Row="1"                                                   FontSize="11" Opacity="0.65" Margin="0,4,0,0">
                                            <Run Text="{Binding Quantity, Mode=OneWay}"/>
                                            <Run Text="шт. ×"/>
                                            <Run Text="{Binding UnitCost, Mode=OneWay, StringFormat='{}{0:N0} ₽'}"/>
                                            <Run Text="="/>
                                            <Run Text="{Binding TotalCost, Mode=OneWay, StringFormat='{}{0:N0} ₽'}"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Visibility="{Binding IsCartNotEmpty,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                    <Separator Opacity="0.2" Margin="0,8,0,12"/>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Итого:"                                   FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock HorizontalAlignment="Right"
                                   FontSize="18" FontWeight="Bold">
                            <Run Text="{Binding CartTotal, Mode=OneWay, StringFormat='{}{0:N0}'}"
                                 Foreground="White"/>
                            <Run Text=" ₽"
                                 Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </TextBlock>
                    </Grid>

                    <ui:InfoBar IsOpen="{Binding ConfirmError,
                                    Converter={StaticResource NullOrEmptyToFalseConverter}}"
                                Severity="Error" Title="{Binding ConfirmError}"
                                IsClosable="False" Margin="0,0,0,8"/>

                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="Принять поставку"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon Checkmark24}"
                                   Command="{Binding ConfirmDeliveryCommand}"
                                   Margin="0,0,8,0"/>
                        <ui:Button Content="Очистить"
                                   Icon="{ui:SymbolIcon Delete24}"
                                   Command="{Binding ClearCartCommand}"
                                   Appearance="Secondary"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
