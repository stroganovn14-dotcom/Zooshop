<Page
    x:Class="ZooShop.Views.Pages.SalesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Style="{StaticResource FadeInPage}"
    Title="Продажи">

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Журнал продаж" Foreground="Black"
                   Style="{StaticResource PageTitleStyle}"/>

        <Border Grid.Row="1" Style="{StaticResource FormCardStyle}" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="С:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="Black"
                           Style="{StaticResource FieldLabelStyle}"/>
                <DatePicker SelectedDate="{Binding FilterFrom}" Margin="0,0,16,0"/>

                <TextBlock Text="По:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="Black"
                           Style="{StaticResource FieldLabelStyle}"/>
                <DatePicker SelectedDate="{Binding FilterTo}" Margin="0,0,16,0"/>

                <ui:Button Content="Применить" Foreground="White"
                           Command="{Binding LoadCommand}"
                           Icon="{ui:SymbolIcon Filter24}"
                           Appearance="Primary"/>
            </StackPanel>
        </Border>

        <ui:DataGrid Grid.Row="2"
                     ItemsSource="{Binding Sales}"
                     AutoGenerateColumns="False"
                     IsReadOnly="True"
                     CanUserSortColumns="True"
                     GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#"         Binding="{Binding Id}"          Width="50"/>
                <DataGridTextColumn Header="Дата"      Binding="{Binding SaleDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="140"/>
                <DataGridTextColumn Header="Тип"       Binding="{Binding ItemTypeDisplay}" Width="100"/>
                <DataGridTextColumn Header="Сумма"     Binding="{Binding TotalSum, StringFormat='{}{0:N2} ₽'}" Width="120"/>
                <DataGridTextColumn Header="Продавец"  Binding="{Binding Seller.FullName}" Width="*"/>
                <DataGridTextColumn Header="Владелец"  Binding="{Binding OwnerName}"   Width="*"/>
                <DataGridTextColumn Header="Телефон"   Binding="{Binding OwnerPhone}"  Width="130"/>
            </DataGrid.Columns>
        </ui:DataGrid>
    </Grid>
</Page>
