<ui:FluentWindow
    x:Class="ZooShop.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Любимый питомец — Вход"
    Width="400" Height="520"
    MinWidth="360" MinHeight="480"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Фон окна — поверх FluentWindow.Background ── -->
        <Rectangle Grid.RowSpan="2" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0D2B1F" Offset="0"/>
                    <GradientStop Color="#1B5E3A" Offset="0.5"/>
                    <GradientStop Color="#0A1E16" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Декоративные круги -->
        <Canvas Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="220" Height="220" Opacity="0.07" Canvas.Left="-70" Canvas.Top="-70">
                <Ellipse.Fill><SolidColorBrush Color="White"/></Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="150" Height="150" Opacity="0.05" Canvas.Left="290" Canvas.Top="340">
                <Ellipse.Fill><SolidColorBrush Color="White"/></Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="90" Height="90" Opacity="0.06" Canvas.Left="340" Canvas.Top="50">
                <Ellipse.Fill><SolidColorBrush Color="White"/></Ellipse.Fill>
            </Ellipse>
            <Path Fill="White" Opacity="0.07" Canvas.Left="20" Canvas.Top="200"
                  RenderTransformOrigin="0.5,0.5"
                  Data="M0,0 C-22,15 -22,45 0,60 C22,45 22,15 0,0Z">
                <Path.RenderTransform><RotateTransform Angle="20"/></Path.RenderTransform>
            </Path>
            <Path Fill="White" Opacity="0.05" Canvas.Left="320" Canvas.Top="150"
                  RenderTransformOrigin="0.5,0.5"
                  Data="M0,0 C-16,11 -16,33 0,44 C16,33 16,11 0,0Z">
                <Path.RenderTransform><RotateTransform Angle="-35"/></Path.RenderTransform>
            </Path>
        </Canvas>

        <!-- ── Заголовок ── -->
        <Grid Grid.Row="0" Background="Transparent"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <TextBlock Text="Любимый питомец" FontSize="12" FontWeight="Medium"
                       Foreground="White" Opacity="0.4"
                       VerticalAlignment="Center" Margin="16,0,0,0"/>
            <ui:Button Width="32" Height="32"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,8,0" Appearance="Transparent"
                       Click="CloseButton_Click" ToolTip="Закрыть">
                <ui:SymbolIcon Symbol="Dismiss24" Foreground="White" Margin="0,0,-4,0"/>
            </ui:Button>
        </Grid>

        <!-- ── Карточка входа ── -->
        <Border Grid.Row="1"
                Margin="28,8,28,28"
                CornerRadius="16"
                BorderThickness="1">
            <Border.Background>
                <SolidColorBrush Color="#CC102818"/>
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush Color="#3AFFFFFF"/>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect Color="#50000000" BlurRadius="28" ShadowDepth="4" Opacity="0.6"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center" Margin="32,28,32,28">

                <!-- Иконка -->
                <Border Width="64" Height="64" CornerRadius="16"
                        HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Border.Background>
                        <SolidColorBrush Color="#5534C47A"/>
                    </Border.Background>
                    <ui:SymbolIcon Symbol="AnimalCat24" FontSize="30"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Вход в систему"
                           FontSize="19" FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Любимый питомец"
                           FontSize="12" Foreground="White" Opacity="0.45"
                           HorizontalAlignment="Center" Margin="0,0,0,24"/>

                <TextBlock Text="Логин" FontSize="12" Foreground="White" Opacity="0.6" Margin="0,0,0,5"/>
                <TextBox
                    Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                    FontSize="14" Height="40" Padding="10,8"
                    BorderThickness="1" BorderBrush="#44FFFFFF"
                    Background="#28FFFFFF" Foreground="White" CaretBrush="White"
                    Margin="0,0,0,14">
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextFillColorPrimaryBrush"        Color="White"/>
                        <SolidColorBrush x:Key="TextFillColorSecondaryBrush"      Color="#CCFFFFFF"/>
                        <SolidColorBrush x:Key="TextControlBackground"            Color="#28FFFFFF"/>
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#38FFFFFF"/>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused"     Color="#38FFFFFF"/>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock Text="Пароль" FontSize="12" Foreground="White" Opacity="0.6" Margin="0,0,0,5"/>
                <PasswordBox
                    x:Name="PwdBox"
                    FontSize="14" Height="40" Padding="10,8"
                    BorderThickness="1" BorderBrush="#44FFFFFF"
                    Background="#28FFFFFF" Foreground="White"
                    Margin="0,0,0,18">
                    <PasswordBox.Resources>
                        <SolidColorBrush x:Key="TextFillColorPrimaryBrush"        Color="White"/>
                        <SolidColorBrush x:Key="TextFillColorSecondaryBrush"      Color="#CCFFFFFF"/>
                        <SolidColorBrush x:Key="TextControlBackground"            Color="#28FFFFFF"/>
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#38FFFFFF"/>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused"     Color="#38FFFFFF"/>
                    </PasswordBox.Resources>
                </PasswordBox>

                <ui:InfoBar Severity="Error"
                            Title="{Binding ErrorMessage}"
                            IsOpen="{Binding HasError}"
                            IsClosable="False"
                            Margin="0,0,0,14"/>

                <ui:Button Appearance="Primary"
                           HorizontalAlignment="Stretch"
                           Height="44"
                           FontSize="14" FontWeight="Medium"
                           Command="{Binding LoginCommand}"
                           IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowRight24" Margin="0,0,8,0"
                                       Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="Войти" VerticalAlignment="Center" Foreground="White"/>
                    </StackPanel>
                </ui:Button>

                <ui:ProgressRing IsIndeterminate="True" Height="26"
                                 Margin="0,10,0,0"
                                 Visibility="{Binding IsBusy,
                                     Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
