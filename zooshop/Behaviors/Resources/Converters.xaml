<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:ZooShop.Converters">

    <conv:BoolToVisibilityConverter        x:Key="BoolToVisibilityConverter"/>
    <conv:NullToVisibilityConverter        x:Key="NullToVisibilityConverter"/>
    <conv:NotNullToVisibilityConverter     x:Key="NotNullToVisibilityConverter"/>
    <conv:ImagePathConverter               x:Key="ImagePathConverter"/>
    <conv:ExpirationBrushConverter         x:Key="ExpirationBrushConverter"/>
    <conv:ExpirationIconConverter          x:Key="ExpirationIconConverter"/>
    <conv:NullOrEmptyStringToBoolConverter x:Key="NullOrEmptyToFalseConverter"/>
    <conv:InverseBoolConverter             x:Key="InverseBoolConverter"/>

</ResourceDictionary>
