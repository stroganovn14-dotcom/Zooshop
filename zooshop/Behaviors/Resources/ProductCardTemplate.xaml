<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:models="clr-namespace:ZooShop.Models"
    xmlns:conv="clr-namespace:ZooShop.Converters">

    <DataTemplate x:Key="ProductCardTemplate" DataType="{x:Type models:Product}">
        <Border x:Name="CardRoot"
                Margin="8" Width="220" CornerRadius="12" Cursor="Hand"
                Background="{DynamicResource AppSidebarBg}"
                BorderBrush="{DynamicResource AppNavHoverBg}"
                BorderThickness="1"
                RenderTransformOrigin="0.5,0.5">

            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick"
                    Command="{Binding DataContext.AddToCartCommand,
                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"/>
            </Border.InputBindings>

            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>

            <Border.Effect>
                <DropShadowEffect Color="#0A000000" BlurRadius="10"
                                  ShadowDepth="1" Direction="270" Opacity="0.35"/>
            </Border.Effect>

            <Border.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                             Storyboard.TargetProperty="ScaleX"
                                             To="1.03" Duration="0:0:0.15">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                             Storyboard.TargetProperty="ScaleY"
                                             To="1.03" Duration="0:0:0.15">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                             Storyboard.TargetProperty="ScaleX"
                                             To="1.0" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                             Storyboard.TargetProperty="ScaleY"
                                             To="1.0" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Фон секции фото -->
                <Rectangle Grid.Row="0" RadiusX="12" RadiusY="12"
                           Fill="{DynamicResource AppNavHoverBg}"/>

                <!-- Картинка через ImageBrush — клипируется самим прямоугольником -->
                <Rectangle Grid.Row="0" RadiusX="12" RadiusY="12"
                           Visibility="{Binding ImagePath,
                               Converter={StaticResource NotNullToVisibilityConverter}}">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="{Binding ImagePath,
                                        Converter={StaticResource ImagePathConverter}}"
                                    Stretch="UniformToFill"/>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Placeholder когда нет фото -->
                <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding ImagePath,
                                Converter={StaticResource NullToVisibilityConverter}}">
                    <ui:SymbolIcon Symbol="ImageOff24"
                                   FontSize="48" HorizontalAlignment="Center" Opacity="0.2"/>
                    <TextBlock Text="Нет фото" FontSize="11" Opacity="0.4"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <ui:Button Grid.Row="0"
                           HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="6" Width="28" Height="28" Padding="0"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon Edit24}"
                           Command="{Binding DataContext.OpenEditCommand,
                               RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                           CommandParameter="{Binding}"
                           Visibility="{Binding DataContext.CanManage,
                               RelativeSource={RelativeSource AncestorType=ItemsControl},
                               Converter={StaticResource BoolToVisibilityConverter}}"/>

                <Border Grid.Row="1" Height="6"
                        Background="{Binding ExpirationDate,
                            Converter={StaticResource ExpirationBrushConverter}}"
                        ToolTip="{Binding ExpirationDate, StringFormat='Срок годности: {0:dd.MM.yyyy}'}"/>

                <StackPanel Grid.Row="2" Margin="14,10,14,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                   FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Name}"/>
                        <ui:SymbolIcon Grid.Column="1" FontSize="16"
                                       Foreground="{Binding ExpirationDate,
                                           Converter={StaticResource ExpirationBrushConverter}}"
                                       Margin="6,0,0,0" VerticalAlignment="Center"
                                       ToolTip="{Binding ExpirationDate, StringFormat='Срок: {0:dd.MM.yyyy}'}">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Symbol" Value="Warning24"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ExpirationDate,
                                            Converter={StaticResource ExpirationIconConverter}}"
                                            Value="&#xE783;">
                                            <Setter Property="Symbol" Value="DismissCircle24"/>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ExpirationDate,
                                            Converter={StaticResource ExpirationIconConverter}}"
                                            Value="&#xE7BA;">
                                            <Setter Property="Symbol" Value="Warning24"/>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </Grid>

                    <TextBlock Text="{Binding Category}" FontSize="11" Opacity="0.55" Margin="0,2,0,0"/>

                    <Separator Margin="0,8,0,8" Opacity="0.12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontSize="18" FontWeight="Bold">
                            <Run Text="{Binding Price, StringFormat='{}{0:N0}'}"/>
                            <Run Text=" ₽" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </TextBlock>
                        <Border Grid.Column="1" CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background"
                                            Value="{DynamicResource AppNavHoverBg}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Stock}" Value="0">
                                            <Setter Property="Background" Value="#30DC3232"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Box24"
                                               FontSize="10" Opacity="0.55"
                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock FontSize="11" FontWeight="Medium">
                                    <Run Text="{Binding Stock}"/>
                                    <Run Text=" шт."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Opacity="0.5"
                                Visibility="{Binding ExpirationDate,
                                    Converter={StaticResource NotNullToVisibilityConverter}}">
                        <ui:SymbolIcon Symbol="CalendarLtr24"
                                       FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0">
                            <Run Text="Годен до: "/>
                            <Run Text="{Binding ExpirationDate, StringFormat='{}{0:dd.MM.yyyy}'}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
